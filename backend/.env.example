# Admin Password for Dashboard Security Gate (Optional)
ADMIN_PASSWORD="your-admin-password"

# Server Configurations
PORT=5000
NODE_ENV=development

# Database Connection
# If using Docker, this is configured automatically by Docker Compose.
# For local native run, replace with your local Postgres URL.
DATABASE_URL="postgresql://postgres:postgres_secure_pass@localhost:5432/flipkart_tracker?schema=public"

# Scraper Schedule (Standard Cron syntax: Minute Hour Day Month Day-of-Week)
# Default runs every 12 hours
SCRAPER_CRON_SCHEDULE="0 */12 * * *"

# 🔔 Notification Integrations (Optional)

# Discord Webhook Integration
# DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/your-channel-id/your-webhook-token"

# Telegram Bot Integration
# TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"
# TELEGRAM_CHAT_ID="987654321"

# SMTP Email Integration for Mailtrap (Testing/Development)
# SMTP_HOST="sandbox.smtp.mailtrap.io"
# SMTP_PORT=2525
# SMTP_USER="your-mailtrap-username"
# SMTP_PASS="your-mailtrap-password"
# NOTIFICATION_FROM_EMAIL="no-reply@tracker.io"

# SMTP Email Integration for Gmail (Production/Gmail SMTP)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-gmail-app-password"
# NOTIFICATION_FROM_EMAIL="your-email@gmail.com"

# JWT authentication
JWT_SECRET=
JWT_EXPIRES_IN=7d
DASHBOARD_PASSWORD_HASH=
